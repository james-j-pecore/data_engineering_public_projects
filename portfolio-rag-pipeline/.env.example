# https://console.anthropic.com/settings/keys — only needed for the generation step;
# indexing, retrieval, and the eval harness's retrieval metrics work without it.
ANTHROPIC_API_KEY=

# Only needed if your key isn't scoped to a single workspace — the API will return a 400
# ("This API key is not scoped to a workspace...") telling you to add this header if so.
# Find it at https://console.anthropic.com/settings/workspaces
ANTHROPIC_WORKSPACE_ID=
